# HiddenAtlas Backend — environment configuration
# Copy to `.env` and adjust for your environment.

# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/hiddenatlas

# CORS
CORS_ORIGIN=http://localhost:5173

# ─── Authentication ───────────────────────────────────
# JWT signing secret — REQUIRED in production, use a long random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-12 recommended)
BCRYPT_SALT_ROUNDS=12
